{
  "name": "ppal",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "@types/node": "^26.2.0",
      "@cloudflare/workers-types": "^5.20260728.1",
      "better-auth": "1.7.1",
      "evlog": "^2.27.1",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "sonner": "^2.0.7",
      "tailwindcss": "^4.3.3",
      "@tanstack/react-form": "^1.33.2",
      "@types/react-dom": "^19.2.3",
      "@better-auth/expo": "1.7.1"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev -F web -F server",
    "dev:all": "turbo run dev",
    "dev:web": "turbo run dev -F web --",
    "dev:server": "turbo run dev -F server --",
    "dev:native": "turbo run dev -F native --",
    "dev:infra": "turbo run dev -F @ppal/infra --",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate -F @ppal/db --",
    "db:migrate:local": "turbo run db:migrate:local -F server --",
    "deploy": "turbo run deploy -F @ppal/infra --",
    "destroy": "turbo run destroy -F @ppal/infra --",
    "check": "ultracite check",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@ppal/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@ppal/config": "workspace:*",
    "@types/node": "catalog:",
    "husky": "latest",
    "oxfmt": "latest",
    "oxlint": "latest",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "ultracite": "7.10.7"
  },
  "overrides": {
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/platform-node-shared": "4.0.0-rc.112",
    "@effect/sql-d1": "4.0.0-rc.112",
    "@effect/sql-sqlite-do": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "effect": "4.0.0-rc.112"
  },
  "packageManager": "bun@1.3.10"
}
