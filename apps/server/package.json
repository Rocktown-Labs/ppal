{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --port 3000 --ip 127.0.0.1",
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:laravel:export": "bun scripts/export-laravel.ts",
    "smoke": "bun scripts/smoke-api.ts",
    "test": "bun test tests"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.7.6",
    "@mmmike/web-push": "1.3.0",
    "@ppal/auth": "workspace:*",
    "@ppal/contracts": "workspace:*",
    "@ppal/db": "workspace:*",
    "@ppal/domain": "workspace:*",
    "@ppal/env": "workspace:*",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "evlog": "catalog:",
    "hono": "^4.12.32",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "catalog:",
    "@ppal/config": "workspace:*",
    "@types/node": "catalog:",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.0"
  }
}
