CORS_ORIGIN=http://127.0.0.1:3001
BETTER_AUTH_URL=http://127.0.0.1:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# Required in production. Used to encrypt OAuth tokens, 2FA secrets, push
# subscription keys, and device tokens at rest. Generate with:
#   openssl rand -base64 32
DATA_ENCRYPTION_KEY=replace-with-a-different-32-byte-random-key
OPERATIONS_API_TOKEN=replace-with-a-different-32-byte-random-token
GEMINI_API_KEY=
SPORTRADAR_API_KEY=
SPORTRADAR_ACCESS_LEVEL=trial
# Optional comma-separated league allowlist (e.g. "nfl"). Empty syncs every
# league; set it to skip leagues whose trials expired so game-day quota and
# worker time go to live leagues only.
SPORTRADAR_LEAGUES=
SPORTRADAR_QPS=1
SPORTRADAR_ROLLING_QUOTA=1000
SPORTRADAR_ROLLING_WINDOW_DAYS=30
SENT_DM_API_KEY=
SENT_DM_TEMPLATE_NAME=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_CREATOR_PRICE_ID=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_CREATOR_YEARLY=
STRIPE_TAX_ENABLED=false
REVENUECAT_WEBHOOK_SECRET=
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bets.myparlaypal.com
RESEND_REPLY_TO_EMAIL=support@bets.myparlaypal.com
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:noreply@support.myparlaypal.com
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
